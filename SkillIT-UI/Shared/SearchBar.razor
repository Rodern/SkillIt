

<div class="search-box-wrapper w-@Width h-[40px] top-@Top bottom-@Bottom left-@Left right-@Right @Position" hidden="@IsVisible">
    <input class="search-input" placeholder="@SearchPlaceholder" type="search" inputmode="text" autofocus/>
    <button class="search-btn" title="" type="button" @onclick="()=>{}">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
    </button>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;
    [Parameter]
    public string SearchPlaceholder { get; set; } = "Seacrch...";
    [Parameter]
    public bool IsVisible { get; set; } = true;
    [Parameter]
    public string IsFloating { get; set; } = string.Empty;
    [Parameter]
    public string Width { get; set; } = "full";
    [Parameter]
    public string Top { get; set; } = "0";
    [Parameter]
    public string Left { get; set; } = "0";
    [Parameter]
    public string Right { get; set; } = "0";
    [Parameter]
    public string Bottom { get; set; } = "0";
    [Parameter]
    public string Position { get; set; } = "relative";

}
