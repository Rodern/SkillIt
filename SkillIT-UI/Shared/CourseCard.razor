<div class="mb-6 lg:mb-0">
	<div class="relative block bg-white rounded-lg shadow-lg">
		<div class="flex">
			<div class="relative overflow-hidden bg-no-repeat bg-cover relative overflow-hidden bg-no-repeat bg-cover shadow-lg rounded-lg mx-4 -mt-4"
				 data-mdb-ripple="true" data-mdb-ripple-color="light">
				<img src="site_data/course_cover_images/@course.CoverImage" class="w-full" />
				<a @onclick="()=>{checkAuth(course.Guid, course.Id);}">
					<div class="absolute top-0 right-0 bottom-0 left-0 w-full h-full overflow-hidden bg-fixed opacity-0 hover:opacity-100 transition duration-300 ease-in-out"
						 style="background-color: rgba(251, 251, 251, 0.15)"></div>
				</a>
			</div>
		</div>
		<div class="p-6">
			<h5 class="font-bold text-lg mb-3">@course.Name</h5>
			<p class="text-gray-500 mb-4">
				<small>
					Published <u>@course.DatePublish.ToString("M"), @course.DatePublish.ToString("yyyy")</u> by
					<a href="" class="text-gray-900">@course.Author.Account.User.FirstName @course.Author.Account.User.LastName</a>
				</small>
			</p>
			<p class="mb-4 pb-2">
				@course.Description.Substring(0, 200)...
			</p>
			<a href="/course_detail/@course.Guid" data-mdb-ripple="true" data-mdb-ripple-color="light"
			   class="inline-block px-6 py-2.5 bg-blue-600 text-white font-medium text-xs leading-tight uppercase rounded-full shadow-md hover:bg-blue-700 hover:shadow-lg focus:bg-blue-700 focus:shadow-lg focus:outline-none focus:ring-0 active:bg-blue-800 active:shadow-lg transition duration-150 ease-in-out">
				Details
			</a>
		</div>
	</div>
</div>

@code {
	[Parameter]
	public Course course { get; set; } = new();

	async void checkAuth(string guid, long courseId)
	{
		bool isLoggedIn = await JSRuntime.InvokeAsync<bool>("isLoggedIn");
		if (isLoggedIn)
		{
			long userId = long.Parse(await JSRuntime.InvokeAsync<string>("getUserId"));

			if (userId != 0)
			{
				var enrollments = EnrollmentService.GetEnrollments(userId);
				if (enrollments.Where(e => e.CourseId == courseId).ToList().Count > 0)
				{
					//NavigationManager.NavigateTo($"/course/{guid}");
					NavigationManager.NavigateTo($"/course_detail/{guid}");
					return;
				}
			}
			NavigationManager.NavigateTo($"/course_detail/{guid}");
			return;
		}
		await JSRuntime.InvokeVoidAsync("requireLogin");
	}
}
