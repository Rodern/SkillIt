@page "/reset_password/{userId:long}"

<div class="completed-course-page page flex justify-center items-center w-full h-full  page cursor-default flex flex-col bottom-0 top-0 left-0 right-0">
	<div class="completed-box">
		<div class="password-reset pass-reset">
			<div class="input-group mb-6 flex flex-col items-end">
				<h4 class="text-lg font-md text-start w-full">Password</h4><div class="password-wrapper flex flex-row gap-2">
					<div class="input-wrapper rounded-md flex flex-row w-full h-9 border hover:shadow overflow-hidden"
						 style="border-radius: 5px;">
						<label class="w-10 h-full flex toggleLock justify-center items-center pl-1" for="catName">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
							</svg>
						</label>
						<input class="w-full px-2 py-1" type="password" name="Password" id="password" placeholder="password"
							   title="Password" maxlength="15" pattern="(?=.*\d)(?=.*[a-z]).{8,15}" required />
					</div>
					<div class="input-wrapper rounded-md flex flex-row w-full h-9 border hover:shadow overflow-hidden"
						 style="border-radius: 5px;">
						<label class="w-10 h-full flex toggleLock justify-center items-center pl-1" for="catName">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
							</svg>
						</label>
						<input class="w-full px-2 py-1" type="password" name="Password" id="cpassword" placeholder="re-enter password"
							   title="Password" maxlength="15" pattern="(?=.*\d)(?=.*[a-z]).{8,15}" required />
					</div>
				</div>
			</div>
			<div class="input-group mt-6 flex justify-center">
				<button class="pass-reset-btn text-md text-white bg-blue-600 w-44 md:text-center hover:shadow-lg hover:bg-blue-700 rounded px-2 sm:px-4 py-2 "
						role="button" @onclick="()=>{SubmitPassword();}">
					RESET
				</button>
			</div>
		</div>
	</div>
</div>


@code {
	[Parameter]
	public long userId { get; set; } = 0;

	[Parameter]
	public string guid {get; set; } = string.Empty;

	string userEmail = string.Empty;

	int code = 0;

	long otpId = 0;


	async void SubmitPassword()
	{
		await JSRuntime.InvokeVoidAsync("resetBtnHandler", otpId, userId, guid, code);
	}

	protected override async void OnParametersSet()
	{
		base.OnParametersSet();
		var user = UserService.GetUser(userId);
		if(user == null)
		{
			NavigationManager.NavigateTo("/link_error");
			return;
		}

		var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri); //you can use IURIHelper for older versions
		if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("guid", out var result1))
		{
			string guid = result1.First();
			this.guid = guid;

			if (!string.IsNullOrEmpty(guid))
			{
				var otp = OtpService.GetOTP(userId, guid);

				if (otp == null)
				{
					NavigationManager.NavigateTo("/link_error");
					return;
				}
				if (otp.Guid == guid)
				{
					userEmail = user.Email;
					code = otp.Code;
					otpId = otp.Id;

					//JSRuntime.InvokeVoidAsync("initResetPage");
					await JSRuntime.InvokeVoidAsync("LoadScripts", "initResetPage");
					return;
				}
			}
		}
		NavigationManager.NavigateTo("/link_error");
	}
}
