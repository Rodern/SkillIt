@page "/course"
@page "/course/{courseId:int}"
@page "/course/{guid}"

<PageTitle>Course - @Course.Name</PageTitle>

<div class="course-page page cursor-default flex flex-col bottom-0 top-0 left-0 right-0">
	<div class="navbar navbar-expand-lg shadow-md py-2 bg-white relative flex items-center w-full justify-between">
		<button id="side_panel_toggler"
				class="menu-btn " type="button"
				aria-controls="offSideCoursePanel"
				data-te-offcanvas-toggle
				data-te-target="#offSideCoursePanel"
				data-te-ripple-init
				data-te-ripple-color="light">
			@*<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" class="w-6 h-6">
				<path fill="black" stroke-linecap="round" stroke-linejoin="round"
					  d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
			</svg>*@
			Panel
		</button>
	</div>

	<div class="side-panel "
				 tabindex="-1"
				 id="offSideCoursePanel"
				 aria-labelledby="offSideCoursePanel"
				 data-te-offcanvas-init>
				<div class="flex items-center justify-between p-4">
					<h5 class="mb-0 font-semibold leading-normal"
						id="offcanvasExampleLabel">
						Course Panel
					</h5>
					<button type="button"
							class="box-content rounded-none border-none opacity-50 hover:no-underline hover:opacity-75 focus:opacity-100 focus:shadow-none focus:outline-none"
							data-te-offcanvas-dismiss>
						<span class="w-[1em] focus:opacity-100 disabled:pointer-events-none disabled:select-none disabled:opacity-25 [&.disabled]:pointer-events-none [&.disabled]:select-none [&.disabled]:opacity-25">
							<svg xmlns="http://www.w3.org/2000/svg"
								 fill="none"
								 viewBox="0 0 24 24"
								 stroke-width="1.5"
								 stroke="currentColor"
								 class="h-6 w-6">
								<path stroke-linecap="round"
									  stroke-linejoin="round"
									  d="M6 18L18 6M6 6l12 12" />
							</svg>
						</span>
					</button>
				</div>
				<div class="flex-grow overflow-y-auto p-4">
			<a href="/courses" class="side-panel-btn btn-type btn-large btn-small relative">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-auto absolute left-0">
					<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
				</svg>
				Courses
			</a>
			<h3 class="course-name">@Course.Name</h3>
			<div class="progress-info">
				<div class="progress-bar w-full bg-gray-200 h-1">
					<div class="progress bg-blue-600 h-1" style="width: @percentage%"></div>
				</div>
				<span class="completion-info">@percentage% Complete</span> <br />
				<span class="sum-of-lessons">@totalNumberOfLessons Lessons</span>
				<span class="out-of">@numberOfCompletedLessons/@totalNumberOfLessons Lessons</span>
			</div>

			<div class="course-breakdown">
				<ul class="course-content-list" start="1">
					@foreach (var chapter in CourseChapters.OrderBy(e => e.ChapterNumber))
					{
						<li class="accordion-button  course-chapter" id="panel_course_chapter_@chapter.Id" data-bs-toggle="collapse" data-bs-target="#panel_collapseChapter_@chapter.Id" role="button" aria-expanded="false" aria-controls="panel_collapseChapter_@chapter.Id">
							@chapter.Title

							<span class="li-right">
								@if (!StudyRecords.FirstOrDefault(x => x.ChapterGuid == chapter.Guid).IsUnlocked)
								{
									<svg title=" is locked" class="li-icons li-locks" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
										<path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3c0-2.9-2.35-5.25-5.25-5.25zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z" clip-rule="evenodd" />
									</svg>
								}


								@if (checkcs(chapter.Id) == -1)
								{
									<svg class="li-icons li-circle-svg" title="Not done" viewBox="0 0 50 50" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg">
										<defs>
											<path d="M0 0L50 0L50 50L0 50L0 0Z" id="pathcc_1" />
											<clipPath id="maskcc_1">
												<use xlink:href="#pathcc_1" />
											</clipPath>
										</defs>
										<g id="Round-Icon">
											<path d="M0 0L50 0L50 50L0 50L0 0Z" id="Background" fill="#FFFFFF" fill-opacity="0" fill-rule="evenodd" stroke="none" />
											<g clip-path="url(#maskcc_1)">
												<path d="M25 2C12.3093 2 2 12.3093 2 25C2 37.6907 12.3093 48 25 48C37.6907 48 48 37.6907 48 25C48 12.3093 37.6907 2 25 2L25 2ZM25 4C36.6098 4 46 13.3902 46 25C46 36.6098 36.6098 46 25 46C13.3902 46 4 36.6098 4 25C4 13.3902 13.3902 4 25 4L25 4Z" id="Shape" class="ri-fill li-svg-fill" fill-rule="evenodd" stroke="none" />
											</g>
										</g>
									</svg>
								}

								@if (checkcs(chapter.Id) == 1)
								{
									<svg class="li-icons li-circle-svg" title="Marked as partially done" viewBox="0 0 50 50" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg">
										<defs>
											<path d="M0 0L50 0L50 50L0 50L0 0Z" id="pathcc_2" />
											<clipPath id="maskcc_2">
												<use xlink:href="#pathcc_2" />
											</clipPath>
										</defs>
										<g id="Check-Circle-Icon">
											<path d="M0 0L50 0L50 50L0 50L0 0Z" id="Background" class="cci-stroke" fill-opacity="0" fill-rule="evenodd" stroke="none" />
											<g clip-path="url(#maskcc_2)">
												<path d="M25 2C12.3093 2 2 12.3093 2 25C2 37.6907 12.3093 48 25 48C37.6907 48 48 37.6907 48 25C48 12.3093 37.6907 2 25 2L25 2ZM25 4C36.6098 4 46 13.3902 46 25C46 36.6098 36.6098 46 25 46C13.3902 46 4 36.6098 4 25C4 13.3902 13.3902 4 25 4L25 4Z" id="Shape" class="cci-stroke-fill li-svg-fill" fill-rule="evenodd" stroke="none" />
												<path d="M45.8333 25C45.8333 36.5052 36.5052 45.8333 25 45.8333C13.4948 45.8333 4.16666 36.5052 4.16666 25C4.16666 13.4948 13.4948 4.16668 25 4.16668C36.5052 4.16668 45.8333 13.4948 45.8333 25L45.8333 25Z" id="Shape" class="cci-tick-circle li-svg-fill-blue" stroke="none" />
											</g>
										</g>
									</svg>
								}

								@if (checkcs(chapter.Id) == 0)
								{
									<svg class="li-icons li-circle-svg" title="Marked as done" viewBox="0 0 50 50" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg">
										<defs>
											<path d="M0 0L50 0L50 50L0 50L0 0Z" id="pathcc_3" />
											<clipPath id="maskcc_3">
												<use xlink:href="#pathcc_3" />
											</clipPath>
										</defs>
										<g id="Check-Circle-Icon">
											<path d="M0 0L50 0L50 50L0 50L0 0Z" id="Background" class="cci-stroke" fill-opacity="0" fill-rule="evenodd" stroke="none" />
											<g clip-path="url(#maskcc_3)">
												<path d="M25 2C12.3093 2 2 12.3093 2 25C2 37.6907 12.3093 48 25 48C37.6907 48 48 37.6907 48 25C48 12.3093 37.6907 2 25 2L25 2ZM25 4C36.6098 4 46 13.3902 46 25C46 36.6098 36.6098 46 25 46C13.3902 46 4 36.6098 4 25C4 13.3902 13.3902 4 25 4L25 4Z" id="Shape" class="cci-stroke-fill li-svg-fill" fill-rule="evenodd" stroke="none" />
												<path d="M45.8333 25C45.8333 36.5052 36.5052 45.8333 25 45.8333C13.4948 45.8333 4.16666 36.5052 4.16666 25C4.16666 13.4948 13.4948 4.16668 25 4.16668C36.5052 4.16668 45.8333 13.4948 45.8333 25L45.8333 25Z" id="Shape" class="cci-tick-circle li-svg-fill-blue" stroke="none" />
												<path d="M36.0271 15.1937L21.8917 29.3458L16.0563 23.5271L13.1104 26.4729L21.8958 35.2375L38.974 18.1396L36.0271 15.1937L36.0271 15.1937Z" id="Shape" class="cci-tick li-svg-fill" stroke="none" />
											</g>
										</g>
									</svg>
								}
							</span>
						</li>



						<ul start="1" class="chapter-lessons collapse" id="panel_collapseChapter_@chapter.Id">
							@foreach (var lesson in chapter.Lessons.OrderBy(e => e.LessonNumber))
							{
								<li id="panel_course_lesson_@lesson.Id" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#panel_collapseChapterLesson_@lesson.Id" role="button" aria-expanded="false" aria-controls="panel_collapseChapterLesson_@lesson.Id">
									<span class="li-left">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
											<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" />
										</svg>
										@lesson.Topic
										<a class="hidden" @onclick="()=>{NavigateTo(Course.Guid, lesson.Id, lesson.Id);}">@lesson.Topic</a>
									</span>
									<span class="li-right">

										@if (!StudyRecords.FirstOrDefault(x => x.LessonId == lesson.Id).IsUnlocked)
										{
											<svg title=" is locked" class="li-icons li-locks" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
												<path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3c0-2.9-2.35-5.25-5.25-5.25zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z" clip-rule="evenodd" />
											</svg>
										}


										@if (checkls(lesson.Id) == -1)
										{
											<svg class="li-icons li-circle-svg" title="Not done" viewBox="0 0 50 50" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg">
												<defs>
													<path d="M0 0L50 0L50 50L0 50L0 0Z" id="pathll_1" />
													<clipPath id="maskll_1">
														<use xlink:href="#pathll_1" />
													</clipPath>
												</defs>
												<g id="Round-Icon">
													<path d="M0 0L50 0L50 50L0 50L0 0Z" id="Background" fill="#FFFFFF" fill-opacity="0" fill-rule="evenodd" stroke="none" />
													<g clip-path="url(#maskll_1)">
														<path d="M25 2C12.3093 2 2 12.3093 2 25C2 37.6907 12.3093 48 25 48C37.6907 48 48 37.6907 48 25C48 12.3093 37.6907 2 25 2L25 2ZM25 4C36.6098 4 46 13.3902 46 25C46 36.6098 36.6098 46 25 46C13.3902 46 4 36.6098 4 25C4 13.3902 13.3902 4 25 4L25 4Z" id="Shape" class="ri-fill li-svg-fill" fill-rule="evenodd" stroke="none" />
													</g>
												</g>
											</svg>
										}

										@if (checkls(lesson.Id) == 1)
										{
											<svg class="li-icons li-circle-svg" title="Marked as done" viewBox="0 0 50 50" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg">
												<defs>
													<path d="M0 0L50 0L50 50L0 50L0 0Z" id="pathll_2" />
													<clipPath id="maskll_2">
														<use xlink:href="#pathll_2" />
													</clipPath>
												</defs>
												<g id="Check-Circle-Icon">
													<path d="M0 0L50 0L50 50L0 50L0 0Z" id="Background" class="cci-stroke" fill-opacity="0" fill-rule="evenodd" stroke="none" />
													<g clip-path="url(#maskll_2)">
														<path d="M25 2C12.3093 2 2 12.3093 2 25C2 37.6907 12.3093 48 25 48C37.6907 48 48 37.6907 48 25C48 12.3093 37.6907 2 25 2L25 2ZM25 4C36.6098 4 46 13.3902 46 25C46 36.6098 36.6098 46 25 46C13.3902 46 4 36.6098 4 25C4 13.3902 13.3902 4 25 4L25 4Z" id="Shape" class="cci-stroke-fill li-svg-fill" fill-rule="evenodd" stroke="none" />
														<path d="M45.8333 25C45.8333 36.5052 36.5052 45.8333 25 45.8333C13.4948 45.8333 4.16666 36.5052 4.16666 25C4.16666 13.4948 13.4948 4.16668 25 4.16668C36.5052 4.16668 45.8333 13.4948 45.8333 25L45.8333 25Z" id="Shape" class="cci-tick-circle li-svg-fill-blue" stroke="none" />
													</g>
												</g>
											</svg>
										}

										@if (checkls(lesson.Id) == 0)
										{
											<svg class="li-icons li-circle-svg" title="Marked as done" viewBox="0 0 50 50" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg">
												<defs>
													<path d="M0 0L50 0L50 50L0 50L0 0Z" id="pathll_3" />
													<clipPath id="maskll_3">
														<use xlink:href="#pathll_3" />
													</clipPath>
												</defs>
												<g id="Check-Circle-Icon">
													<path d="M0 0L50 0L50 50L0 50L0 0Z" id="Background" class="cci-stroke" fill-opacity="0" fill-rule="evenodd" stroke="none" />
													<g clip-path="url(#maskll_3)">
														<path d="M25 2C12.3093 2 2 12.3093 2 25C2 37.6907 12.3093 48 25 48C37.6907 48 48 37.6907 48 25C48 12.3093 37.6907 2 25 2L25 2ZM25 4C36.6098 4 46 13.3902 46 25C46 36.6098 36.6098 46 25 46C13.3902 46 4 36.6098 4 25C4 13.3902 13.3902 4 25 4L25 4Z" id="Shape" class="cci-stroke-fill li-svg-fill" fill-rule="evenodd" stroke="none" />
														<path d="M45.8333 25C45.8333 36.5052 36.5052 45.8333 25 45.8333C13.4948 45.8333 4.16666 36.5052 4.16666 25C4.16666 13.4948 13.4948 4.16668 25 4.16668C36.5052 4.16668 45.8333 13.4948 45.8333 25L45.8333 25Z" id="Shape" class="cci-tick-circle li-svg-fill-blue" stroke="none" />
														<path d="M36.0271 15.1937L21.8917 29.3458L16.0563 23.5271L13.1104 26.4729L21.8958 35.2375L38.974 18.1396L36.0271 15.1937L36.0271 15.1937Z" id="Shape" class="cci-tick li-svg-fill" stroke="none" />
													</g>
												</g>
											</svg>
										}

									</span>
								</li>
								<ul start="1" class="chapter-lessons collapse" id="panel_collapseChapterLesson_@lesson.Id">
									@foreach (var content in CourseService.GetCourseContents(lesson.Id).OrderBy(e => e.ContentNumber))
									{
										<li id="panel_course_content_@content.Id" disabled="@(!StudyRecords.FirstOrDefault(x => x.ContentGuid == content.Guid).IsUnlocked)">
											<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
												<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" />
											</svg>

											@*<a @onclick="()=>{NavigateToContent(Course.Guid, lesson.Id, content.Id, content.Id);}">@content.Title</a>*@
											<a @onclick="()=>{NavigateToContent(content.Guid);}">@content.Title</a>


											<span class="li-right">
												@if (!StudyRecords.FirstOrDefault(x => x.ContentId == content.Id).IsDone)
												{
													<svg class="li-icons li-circle-svg" title="Not done" viewBox="0 0 50 50" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg">
														<defs>
															<path d="M0 0L50 0L50 50L0 50L0 0Z" id="pathct_1" />
															<clipPath id="maskct_1">
																<use xlink:href="#pathct_1" />
															</clipPath>
														</defs>
														<g id="Round-Icon">
															<path d="M0 0L50 0L50 50L0 50L0 0Z" id="Background" fill="#FFFFFF" fill-opacity="0" fill-rule="evenodd" stroke="none" />
															<g clip-path="url(#maskct_1)">
																<path d="M25 2C12.3093 2 2 12.3093 2 25C2 37.6907 12.3093 48 25 48C37.6907 48 48 37.6907 48 25C48 12.3093 37.6907 2 25 2L25 2ZM25 4C36.6098 4 46 13.3902 46 25C46 36.6098 36.6098 46 25 46C13.3902 46 4 36.6098 4 25C4 13.3902 13.3902 4 25 4L25 4Z" id="Shape" class="ri-fill li-svg-fill" fill-rule="evenodd" stroke="none" />
															</g>
														</g>
													</svg>
												}

												@if (StudyRecords.FirstOrDefault(x => x.ContentId == content.Id).IsDone)
												{
													<svg class="li-icons li-circle-svg" title="Marked as done" viewBox="0 0 50 50" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg">
														<defs>
															<path d="M0 0L50 0L50 50L0 50L0 0Z" id="pathct_2" />
															<clipPath id="maskct_2">
																<use xlink:href="#pathct_2" />
															</clipPath>
														</defs>
														<g id="Check-Circle-Icon">
															<path d="M0 0L50 0L50 50L0 50L0 0Z" id="Background" class="cci-stroke" fill-opacity="0" fill-rule="evenodd" stroke="none" />
															<g clip-path="url(#maskct_2)">
																<path d="M25 2C12.3093 2 2 12.3093 2 25C2 37.6907 12.3093 48 25 48C37.6907 48 48 37.6907 48 25C48 12.3093 37.6907 2 25 2L25 2ZM25 4C36.6098 4 46 13.3902 46 25C46 36.6098 36.6098 46 25 46C13.3902 46 4 36.6098 4 25C4 13.3902 13.3902 4 25 4L25 4Z" id="Shape" class="cci-stroke-fill li-svg-fill" fill-rule="evenodd" stroke="none" />
																<path d="M45.8333 25C45.8333 36.5052 36.5052 45.8333 25 45.8333C13.4948 45.8333 4.16666 36.5052 4.16666 25C4.16666 13.4948 13.4948 4.16668 25 4.16668C36.5052 4.16668 45.8333 13.4948 45.8333 25L45.8333 25Z" id="Shape" class="cci-tick-circle li-svg-fill-blue" stroke="none" />
															</g>
														</g>
													</svg>
												}
											</span>
										</li>
									}
								</ul>
							}
						</ul>
					}
				</ul>
			</div>
				</div>
			</div>

	
	<div class="view-wrapper">

		<div class="course-view side-c-view">
			<div class="breadcrumb">
				<a class="breadcrumb-item" href="/course_detail/@Course.Guid">@Course.Name </a> <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="">
					<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
				</svg> <a href="/course/@Course.Guid?cryptId=@Enrollment.Id&courseIndexId=@courseIndexId" class="breadcrumb-item">@Chapter.Title</a>
			</div>
			<div class="course-progress mt-4">
				CHAPTER <span class="chapter-number">&nbsp; @Chapter.ChapterNumber OF @CourseChapters.Count </span>&nbsp;<p class="text-blue-800"> In Progress</p>
				<button class="course-action-btn hidden btn-large header-btn">ACTION</button>
			</div>
			<h2 class="course-view-title">
				@Chapter.Title
			</h2>
			<div class="course-breakdown">
				<div class="cb-header">
					<h4 class="">Chapter Lessons</h4>
					<div class="right-section">
						<span class="completion-info hidden">5% Complete </span>
						<span class="sum-of-lessons">@numberOfLessons Lessons</span>
					</div>
				</div>
				<ul start="1" class="chapter-lessons" id="cv_collapseChapter_@Chapter.Id">
					@foreach (var lesson in Chapter.Lessons.OrderBy(e => e.LessonNumber))
					{
						<li id="course_lesson_@lesson.Id" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#collapseChapterLesson_@lesson.Id" role="button" aria-expanded="false" aria-controls="collapseChapterLesson_@lesson.Id">
							<span class="li-left">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
									<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" />
								</svg>
								@lesson.Topic
								<a class="hidden" @onclick="()=>{NavigateTo(Course.Guid, lesson.Id, lesson.Id);}">@lesson.Topic</a>
							</span>
							<span class="li-right">

								@if(!StudyRecords.FirstOrDefault(x => x.LessonId == lesson.Id).IsUnlocked)
								{
									<svg title=" is locked" class="li-icons li-locks" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
										<path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3c0-2.9-2.35-5.25-5.25-5.25zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z" clip-rule="evenodd" />
									</svg>
								}
							

								@if(checkls(lesson.Id) == -1)
								{
									<svg class="li-icons li-circle-svg" title="Not done" viewBox="0 0 50 50" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg">
										<defs>
											<path d="M0 0L50 0L50 50L0 50L0 0Z" id="path_1" />
