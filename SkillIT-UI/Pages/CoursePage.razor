								@if (checkls(lesson.Id) == 0)
								{
									<svg class="li-icons li-circle-svg" title="Marked as done" viewBox="0 0 50 50" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg">
										<defs>
											<path d="M0 0L50 0L50 50L0 50L0 0Z" id="pathl_3" />
											<clipPath id="maskl_3">
												<use xlink:href="#pathl_3" />
											</clipPath>
										</defs>
										<g id="Check-Circle-Icon">
											<path d="M0 0L50 0L50 50L0 50L0 0Z" id="Background" class="cci-stroke" fill-opacity="0" fill-rule="evenodd" stroke="none" />
											<g clip-path="url(#maskl_3)">
												<path d="M25 2C12.3093 2 2 12.3093 2 25C2 37.6907 12.3093 48 25 48C37.6907 48 48 37.6907 48 25C48 12.3093 37.6907 2 25 2L25 2ZM25 4C36.6098 4 46 13.3902 46 25C46 36.6098 36.6098 46 25 46C13.3902 46 4 36.6098 4 25C4 13.3902 13.3902 4 25 4L25 4Z" id="Shape" class="cci-stroke-fill li-svg-fill" fill-rule="evenodd" stroke="none" />
												<path d="M45.8333 25C45.8333 36.5052 36.5052 45.8333 25 45.8333C13.4948 45.8333 4.16666 36.5052 4.16666 25C4.16666 13.4948 13.4948 4.16668 25 4.16668C36.5052 4.16668 45.8333 13.4948 45.8333 25L45.8333 25Z" id="Shape" class="cci-tick-circle li-svg-fill-blue" stroke="none" />
												<path d="M36.0271 15.1937L21.8917 29.3458L16.0563 23.5271L13.1104 26.4729L21.8958 35.2375L38.974 18.1396L36.0271 15.1937L36.0271 15.1937Z" id="Shape" class="cci-tick li-svg-fill" stroke="none" />
											</g>
										</g>
									</svg>
								}
							
							</span>
						</li>
						<ul start="1" class="chapter-lessons collapse" id="collapseChapterLesson_@lesson.Id">
							@foreach (var content in CourseService.GetCourseContents(lesson.Id).OrderBy(e => e.ContentNumber))
							{
								<li id="course_content_@content.Id" disabled="@(!StudyRecords.FirstOrDefault(x => x.ContentGuid == content.Guid).IsUnlocked)">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
										<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" />
									</svg>

									@*<a @onclick="()=>{NavigateToContent(Course.Guid, lesson.Id, content.Id, content.Id);}">@content.Title</a>*@
									<a @onclick="()=>{NavigateToContent(content.Guid);}">@content.Title</a>

									
								<span class="li-right">
									@if (!StudyRecords.FirstOrDefault(x => x.ContentId == content.Id).IsDone)
									{
										<svg class="li-icons li-circle-svg" title="Not done" viewBox="0 0 50 50" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg">
											<defs>
												<path d="M0 0L50 0L50 50L0 50L0 0Z" id="pathc_1" />
												<clipPath id="maskc_1">
													<use xlink:href="#pathc_1" />
												</clipPath>
											</defs>
											<g id="Round-Icon">
												<path d="M0 0L50 0L50 50L0 50L0 0Z" id="Background" fill="#FFFFFF" fill-opacity="0" fill-rule="evenodd" stroke="none" />
												<g clip-path="url(#maskc_1)">
													<path d="M25 2C12.3093 2 2 12.3093 2 25C2 37.6907 12.3093 48 25 48C37.6907 48 48 37.6907 48 25C48 12.3093 37.6907 2 25 2L25 2ZM25 4C36.6098 4 46 13.3902 46 25C46 36.6098 36.6098 46 25 46C13.3902 46 4 36.6098 4 25C4 13.3902 13.3902 4 25 4L25 4Z" id="Shape" class="ri-fill li-svg-fill" fill-rule="evenodd" stroke="none" />
												</g>
											</g>
										</svg>
									}

									@if (StudyRecords.FirstOrDefault(x => x.ContentId == content.Id).IsDone)
									{
										<svg class="li-icons li-circle-svg" title="Marked as done" viewBox="0 0 50 50" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg">
											<defs>
												<path d="M0 0L50 0L50 50L0 50L0 0Z" id="pathc_2" />
												<clipPath id="maskc_2">
													<use xlink:href="#pathc_2" />
												</clipPath>
											</defs>
											<g id="Check-Circle-Icon">
												<path d="M0 0L50 0L50 50L0 50L0 0Z" id="Background" class="cci-stroke" fill-opacity="0" fill-rule="evenodd" stroke="none" />
												<g clip-path="url(#maskc_2)">
													<path d="M25 2C12.3093 2 2 12.3093 2 25C2 37.6907 12.3093 48 25 48C37.6907 48 48 37.6907 48 25C48 12.3093 37.6907 2 25 2L25 2ZM25 4C36.6098 4 46 13.3902 46 25C46 36.6098 36.6098 46 25 46C13.3902 46 4 36.6098 4 25C4 13.3902 13.3902 4 25 4L25 4Z" id="Shape" class="cci-stroke-fill li-svg-fill" fill-rule="evenodd" stroke="none" />
													<path d="M45.8333 25C45.8333 36.5052 36.5052 45.8333 25 45.8333C13.4948 45.8333 4.16666 36.5052 4.16666 25C4.16666 13.4948 13.4948 4.16668 25 4.16668C36.5052 4.16668 45.8333 13.4948 45.8333 25L45.8333 25Z" id="Shape" class="cci-tick-circle li-svg-fill-blue" stroke="none" />
												</g>
											</g>
										</svg>
									}
								</span>
							</li>
							}
						</ul>
					}
				</ul>
			</div>
		</div>

		<div class="course-view">
			<div class="breadcrumb">
				<a href="/course_detail/@Course.Guid" class="breadcrumb-item">@Course.Name</a> <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="">
					<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
				</svg> <a href="/course/@Course.Guid?cryptId=@Enrollment.Id&courseIndexId=@courseIndexId" class="breadcrumb-item">@Chapter.Title</a> <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="">
					<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
				</svg> <a class="breadcrumb-item">@Lesson.Topic</a>
			</div>
			<div class="course-progress mt-4">
				CHAPTER <span class="chapter-number">&nbsp; @Chapter.ChapterNumber OF @CourseChapters.Count </span>&nbsp;<p class="text-blue-800"> In Progress</p>
				<button class="course-action-btn hidden btn-large header-btn">ACTION</button>
			</div>
			<h2 class="course-view-title">
				@Lesson.Topic
			</h2>

			<div class="flex flex-wrap justify-center space-x-2">
				<span class="px-4 py-2 rounded-full text-gray-500 bg-gray-200 font-semibold text-sm flex align-center w-max cursor-pointer active:bg-gray-300 transition duration-300 ease">
					@Content.Title
				</span>
			</div>

			<article class="content">
				<h5>Content Title: @Content.Title</h5>
				@if(Content.VideoLink != "")
				{
					@Content.VideoLink
				}
				<p>@((MarkupString)Content.Content)</p>
			</article>
			<div class="bottom-nav mt-6 hidden">
				<a class="prev-content btn-type btn-large" @onclick="()=>{PreviousContent(courseIndexId-1);}">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
					  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
					</svg>
					Previous
				</a>

				<a class="next-content btn-type btn-large" @onclick="()=>{NextContent(courseIndexId+1);}">
					Next
				</a>
			</div>
		</div>

	</div>
</div>

@code {
	[Parameter]
	public long courseId { get; set; } = 0;
	[Parameter]
	public long chapterId { get; set; } = 0;
	[Parameter]
	public long lessonId { get; set; } = 0;
	[Parameter]
	public long contentId { get; set; } = 0;
	[Parameter]
	public long courseIndexId { get; set; } = 0;
	[Parameter]
	public int cryptId { get; set; } = 0;
	[Parameter]
	public string guid { get; set; } = string.Empty;

	private Course Course { get; set; } = new();
	private CourseChapter Chapter { get; set; } = new();
	private CourseLesson Lesson { get; set; } = new();
	private CourseContent Content { get; set; } = new();
	private Enrollment Enrollment { get; set; } = new();
	private CourseData CourseDatum { get; set; } = new();

	private ObservableCollection<CourseChapter> CourseChapters { get; set; } = new();
	private ObservableCollection<CourseContent> Contents { get; set; } = new();
	private ObservableCollection<Enrollment> Enrollments { get; set; } = new();
	private ObservableCollection<CourseIndex> StudyRecords = new();

	int count = 0;
	int numberOfLessons = 0, totalNumberOfLessons = 0, numberOfChapters = 0, numberOfCompletedLessons = 0;

	int lessonNumber = 0, contentNumber = 0, FirstIndex = 1, LastIndex = 0;
	float percentage = 0;

	async void PreviousContent(long indexId)
	{
		if (indexId < FirstIndex) return;
		//var index = StudyRecords[indexId];
		string link = $"/course/{guid}?cryptId={Enrollment.Id}&courseIndexId={indexId}";
		courseIndexId = indexId;
		SetContent(Enrollment.Id, indexId);
		await JSRuntime.InvokeVoidAsync("setUrl", link);
		//NavigationManager.NavigateTo(link);
	}

	int checkls(long id)
	{
		var rec = StudyRecords.Where(x => x.LessonId == id);
		int total = rec.ToList().Count;
		int numberedMarkDone = rec.Where(x => x.IsDone == true).ToList().Count();
		if (numberedMarkDone == total) return 0;
		if (numberedMarkDone > 0) return 1;
		return -1;
	}


	int checkcs(long id)
	{
		var rec = StudyRecords.Where(x => x.ContentId == id);
		int total = rec.ToList().Count;
		int numberedMarkDone = rec.Where(x => x.IsDone == true).ToList().Count();
		if (numberedMarkDone == total) return 0;
		if (numberedMarkDone > 0) return 1;
		return -1;
	}

	string isDisabled(int val)
	{
		switch (val)
		{
			case -1:
				return "li-disabled";
			case 0:
			case 1:
			default:
				return "li-enabled";
		}
	}

	bool disabledLi(int val)
	{
		switch (val)
		{
			case -1:
				return true;
			case 0:
			case 1:
			default:
				return false;
		}
	}

	async void NextContent(long indexId)
	{
		if (indexId > LastIndex)
		{

			StudyRecords.FirstOrDefault(x => x.CourseIndexId == indexId - 1).IsDone = true;

			var datum = CourseService.GetCourseDatumByEnrollmentId(cryptId);
			datum.StudyRecord = JsonConvert.SerializeObject(StudyRecords);
			EntityService.UpdateEntity<CourseData>(datum);

			Enrollment.DateCompleted = DateTime.UtcNow;
			Enrollment.IsCompleted = true;
			EnrollmentService.UpdateEnrollment(Enrollment);

			SetContent(Enrollment.Id, indexId - 1);
			if(StudyRecords.Count(x => x.IsDone == false) > 0)
			{
				var index = StudyRecords.FirstOrDefault(x => x.IsDone == false);
				SetContent(Enrollment.Id, index.CourseIndexId);
				return;

			}
			NavigationManager.NavigateTo($"/course/completed/{Course.Guid}?cryptId={Enrollment.Id}");
			return;
		}
		//var index = StudyRecords[indexId];
		string link = $"/course/{guid}?cryptId={Enrollment.Id}&courseIndexId={indexId}";
		courseIndexId = indexId;

		StudyRecords.FirstOrDefault(x => x.CourseIndexId == indexId - 1).IsDone = true;
		StudyRecords.FirstOrDefault(x => x.CourseIndexId == indexId).IsUnlocked = true;

		var data = CourseService.GetCourseDatumByEnrollmentId(cryptId);
		data.StudyRecord = JsonConvert.SerializeObject(StudyRecords);
		EntityService.UpdateEntity<CourseData>(data);

		SetContent(Enrollment.Id, indexId);
		await JSRuntime.InvokeVoidAsync("setUrl", link);

		if(indexId == LastIndex)
		{
			StudyRecords.FirstOrDefault(x => x.CourseIndexId == indexId - 1).IsDone = true;

			var datum = CourseService.GetCourseDatumByEnrollmentId(cryptId);
			datum.StudyRecord = JsonConvert.SerializeObject(StudyRecords);
			EntityService.UpdateEntity<CourseData>(datum);

			SetContent(Enrollment.Id, indexId);
			return;
		}

		//NavigationManager.NavigateTo(link);
	}

	async void SetContent(long enId, long indexId)
	{
		CourseDatum = CourseService.GetCourseDatumByEnrollmentId(enId);

		if (CourseDatum == null)
		{
			NavigationManager.NavigateTo("/courses");
			return;
		}

		string studyRecordString = CourseDatum.StudyRecord;

		StudyRecords = new(JsonConvert.DeserializeObject<ObservableCollection<CourseIndex>>(studyRecordString).Where(x => x.IsDeleted == false).OrderBy(x => x.CourseIndexId));
		LastIndex = StudyRecords.Count;
		CourseIndex index = StudyRecords.FirstOrDefault(i => i.CourseIndexId == indexId);

		if (index == null)
		{
			NavigationManager.NavigateTo("/courses");
			return;
		}

		if (!index.IsUnlocked)
		{
			index = StudyRecords.LastOrDefault(i => i.IsUnlocked == true);
			string link = $"/course/{guid}?cryptId={Enrollment.Id}&courseIndexId={index.CourseIndexId}";
			await JSRuntime.InvokeVoidAsync("setUrl", link);
			courseIndexId = index.CourseIndexId;
		}

		Chapter = CourseService.GetCourseChapter(index.ChapterId);
		Lesson = CourseService.GetCourseLesson(index.LessonId);
		Content = CourseService.GetCourseContent(index.CourseId);

		CourseChapters = CourseService.GetCourseChapters(Course.Id);
		totalNumberOfLessons = 0;
		for (int i = 0; i < CourseChapters.Count; i++)
		{
			CourseChapters[i].Lessons = CourseService.GetCourseLessons(CourseChapters[i].Id);
			totalNumberOfLessons += CourseChapters[i].Lessons.Count;
		}
		numberOfCompletedLessons = StudyRecords.Where(x => x.IsDone == true).GroupBy(x => x.LessonId).Select(group => group.First()).ToList().Count;

		percentage = (float.Parse($"{numberOfCompletedLessons}") / float.Parse($"{totalNumberOfLessons}")) * 100;

		await JSRuntime.InvokeVoidAsync("console.log", numberOfCompletedLessons, totalNumberOfLessons);


		numberOfChapters = CourseChapters.Count;

		numberOfLessons = CourseChapters.FirstOrDefault(cc => cc.Id == index.ChapterId).Lessons.Count;
		this.StateHasChanged();
	}

	Course GetCourse(long courseId)
	{
		return CourseService.GetCourse(courseId);
	}
	Course GetCourseByGuid(string guid)
	{
		return CourseService.GetCourseByGuid(guid);
	}

	void NavigateTo(string guid, long chapterId, long lessonId)
	{
		var index = StudyRecords.FirstOrDefault(x => x.ChapterId == chapterId && x.LessonId == lessonId);
		var indexId = index.CourseIndexId;
		if (index.IsUnlocked == false) return;
		NavigationManager.NavigateTo($"/course/{guid}?cryptId={Enrollment.Id}&courseIndexId={indexId}", true);
		return;
	}

	void NavigateToContent(string guid, int chapterId, int lessonId, int contentId)
	{
		var index = StudyRecords.FirstOrDefault(x => x.ChapterId == chapterId && x.LessonId == lessonId && x.ContentId == contentId);
		JSRuntime.InvokeVoidAsync("console.log", chapterId, lessonId, contentId, index, StudyRecords);
		var indexId = StudyRecords.FirstOrDefault(x => x.ChapterId == chapterId && x.LessonId == lessonId && x.ContentId == contentId).CourseIndexId;
		NavigationManager.NavigateTo($"/course/{guid}?cryptId={Enrollment.Id}&courseIndexId={indexId}", true);
		return;
	}

	void NavigateToContent(string contentGuid)
	{
		var index = StudyRecords.FirstOrDefault(x => x.ContentGuid == contentGuid);
		var indexId = index.CourseIndexId;
		if (index.IsUnlocked == false) return;
		NavigationManager.NavigateTo($"/course/{guid}?cryptId={Enrollment.Id}&courseIndexId={indexId}", true);
		return;
	}

	protected override async void OnParametersSet()
	{
		Loader();

		base.OnParametersSet();
	}

	async void Loader()
	{
		if (courseId == 0)
		{
			if (guid == string.Empty || guid == "")
			{
				NavigationManager.NavigateTo("/courses");
				return;
			}
		}

		if (guid != "" && courseId == 0)
		{
			Course = GetCourseByGuid(guid);

			if (Course == null)
			{
				NavigationManager.NavigateTo("/courses");
				return;
			}

			try
			{
				var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri); //you can use IURIHelper for older versions

				if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("cryptId", out var result6))
				{
					int cryptId = int.Parse(result6.First());
					this.cryptId = cryptId;

					long userId = long.Parse(await JSRuntime.InvokeAsync<string>("getUserId"));

					Enrollment = EnrollmentService.GetEnrollment(cryptId);

					if (Enrollment == null || userId == 0 || Enrollment.UserId != userId || Enrollment.CourseId != Course.Id)
					{
						NavigationManager.NavigateTo("/courses");
						return;
					}

					if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("courseIndexId", out var result7))
					{
						int courseIndexId = int.Parse(result7.First());
						this.courseIndexId = courseIndexId;

						SetContent(cryptId, courseIndexId);
					}
				}
			}
			catch (Exception)
			{

			}
		}
	}

	protected override async void OnAfterRender(bool firstRender)
	{
		base.OnAfterRender(firstRender);


		if (!firstRender)
		{
			//Loader();
			//this.StateHasChanged();
		}

		if(string.IsNullOrEmpty(Course.Guid) == true)
		{
			NavigationManager.NavigateTo("/courses");
		}
		//JSRuntime.InvokeVoidAsync("initCoursePage");
		await JSRuntime.InvokeVoidAsync("LoadScripts", "initCoursePage");
	}

	protected override Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			
		}
		return base.OnAfterRenderAsync(firstRender);
	}
}
