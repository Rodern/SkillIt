@code {
	[Parameter]
	public string section { get; set; } = "";

	private ElementReference aboutSection;

	private string twitterHandle = "@skill_IT4All";

	private ObservableCollection<Course> CoursesList { get; set; } = new();

	protected override async void OnAfterRender(bool firstRender)
	{
		if (firstRender)
		{
			var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri); //you can use IURIHelper for older versions
			if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("section", out var result1))
			{
				section = result1.First();
				if (section == "about")
				{
					JSRuntime.InvokeVoidAsync("scrollToAbout");
					await aboutSection.FocusAsync();
				}
			}
			//JSRuntime.InvokeVoidAsync("initIndex");
			await JSRuntime.InvokeVoidAsync("LoadScripts", "initIndex");

			CoursesList = CourseStaticHelper.GetCourses();
			this.StateHasChanged();
		}
		base.OnAfterRender(firstRender);
	}

	
}