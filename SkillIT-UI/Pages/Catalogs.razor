@page "/catalogs"

<PageTitle>SkillIT - Catalogs</PageTitle>

<div class="catalogs-page page cursor-default text-white flex flex-col bottom-0 top-0 left-0 right-0">

    <div class="cats-body flex flex-col-reverse md:flex-row text-slate-700 bg-white min-h-[93vh] p-6 md:p-2">
        
        <AuthorizeView Policy="admin" Context="addCatalogContext">
            <Authorized>
                <div class="add-catalog-form flex flex-col min-w-[auto] md:min-w-[38vh] justify-center items-center h-auto md:h-full mt-24 md:mt-4 md:mb-auto">
                    <h1 class="font-bold text-2xl mb-10 text-center">Add new catalog</h1>
                    <EditForm Model="@Catalog" class="cat-form rounded-lg shadow-lg px-4 py-5">
                        <div class="input-group mb-6 flex flex-col">
                            <h4 class="text-lg font-md ">Title</h4>
                            <div class="input-wrapper rounded-md flex flex-row w-full h-10 border hover:shadow overflow-hidden"
                                 style="border-radius: 5px;">
                                <label for="catTitle">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" class="">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                                    </svg>
                                </label>
                                <input @bind="@Catalog.Title" class="w-full px-2 py-1" type="text" name="catalog-Title" id="catTitle"
                                       placeholder="catalog Title" autocapitalize="on" title="Catalog Title" />
                            </div>
                        </div>
                        <div class="input-group mb-6">
                            <label class="text-lg font-md " for="catDesc">Descriptions</label>
                            <div class="input-wrapper rounded-md flex flex-row w-full h-24 border hover:shadow overflow-hidden"
                                 style="border-radius: 5px;">
                                <textarea @bind="@Catalog.Descriptions" class="h-full w-full px-2 py-1" type="text" name="catalog-desc" placeholder="Descriptions"
                                          id="catDesc" autocapitalize="on" title="Catalog Descriptions"></textarea>
                            </div>
                        </div>
                        <div class="input-group hidden mb-6">
                            <h4 class="text-lg font-md ">Image</h4>
                            <div class="input-wrapper items-center rounded-md flex flex-row w-full h-10 border hover:shadow overflow-hidden">
                                <input class="w-full px-2 py-1" type="file" name="catalog-img" id="catImg" placeholder="catalog's image"
                                       title="Catalog image" />
                            </div>
                        </div>
                        <div class="input-group mb-6 flex flex-col">
                            <h4 class="text-lg font-md ">Link</h4>
                            <div class="input-wrapper rounded-md flex flex-row w-full h-10 border hover:shadow overflow-hidden"
                                 style="border-radius: 5px;">
                                <label for="catLink">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                         class="">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                                    </svg>
                                </label>
                                <input @bind="@Catalog.Link" class="w-full px-2 py-1" type="text" name="catalog-link" id="catLink" placeholder="catalog link"
                                       pattern="https?://.+" title="Must include http:// or https://" />
                            </div>
                        </div>
                        <div class="input-group mt-6 flex justify-center">
                            <button @onclick="()=>{SaveCatalog();}" class="save-cat-btn text-white bg-blue-600 w-44 md:text-center hover:shadow-lg hover:bg-blue-700 rounded px-2 sm:px-4 py-2 "
                                    role="button">
                                SAVE
                            </button>
                        </div>
                    </EditForm>
                </div>
            </Authorized>
        </AuthorizeView>
        
        


        <div class="catalog-list p-2 w-full overflow-y-auto">
            <div class="list-header mb-12 w-full flex flex-row justify-around">
                <h1 class="font-bold text-2xl text-center">All catalogs</h1>
                
                <div class="search-box-wrapper ">
                    <input class="search-input" @bind="searchValue" @onkeyup="()=>{SearchCollection(searchValue);}" placeholder="@SearchPlaceholder" type="search" inputmode="text" autofocus/>
                    <button class="search-btn" title="" type="button" @onclick="()=>{SearchCollection(searchValue);}">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                        </svg>
                    </button>
                </div>

            </div>
            <div class="cat-list flex flex-row flex-wrap gap-14 gap-10 w-auto mx-0 sm:mx-auto sm:w-full p-6 justify-around md:justify-evenly h-auto p-3">
                
                @if(PageCatalogs.Count > 0)
                {
                    foreach (var catalog in PageCatalogs)
                    {
                        <CatalogCard Catalog="@catalog"></CatalogCard>
                    }
                    //JSRuntime.InvokeVoidAsync("initCatalogs");
                    JSRuntime.InvokeVoidAsync("LoadScripts", "initCatalogs");
                }
                else
                {
                    <div class="empty-list">
                        Nothing here yet!
                    </div>
                    JSRuntime.InvokeVoidAsync("LoadScripts", "initCatalogs");
                }
            </div>
        </div>
    </div>
</div>


@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;
    [Parameter]
    public string SearchPlaceholder { get; set; } = "Search catalogs...";
    [Parameter]
    public bool IsVisible { get; set; } = true;
    [Parameter]
    public string IsFloating { get; set; } = string.Empty;
    [Parameter]
    public string Width { get; set; } = "full";
    [Parameter]
    public string Top { get; set; } = "0";
    [Parameter]
    public string Left { get; set; } = "0";
    [Parameter]
    public string Right { get; set; } = "0";
    [Parameter]
    public string Bottom { get; set; } = "0";
    [Parameter]
    public string Position { get; set; } = "relative";

    string searchValue = "";

    public Catalog Catalog { get; set; } = new();

    async void SaveCatalog()
    {
        await JSRuntime.InvokeVoidAsync("addCatalogRequest", this.Catalog);
    }

    public void SearchCollection(string value)
    {
        ObservableCollection<Catalog> catalogs = new(AllCatalogs.Where(c => c.Title.ToLower().Contains(value) == true || c.Title.ToLower().StartsWith(value) == true || c.Title.ToLower().EndsWith(value) == true).ToList());
        if (catalogs.Count == 0) catalogs = new(AllCatalogs.Where(c => c.Descriptions.ToLower().Contains(value) == true || c.Descriptions.ToLower().StartsWith(value) == true || c.Descriptions.ToLower().EndsWith(value) == true).ToList());
        PageCatalogs = catalogs;
        if (string.IsNullOrEmpty(value)) PageCatalogs = AllCatalogs;

        this.StateHasChanged();
    }

    public ObservableCollection<Catalog> PageCatalogs { get; set; } = new();
    public ObservableCollection<Catalog> AllCatalogs { get; set; } = new();

    protected override Task OnInitializedAsync()
    {
        AllCatalogs = CatalogService.GetAllCatalogs();
        PageCatalogs = AllCatalogs;
        return base.OnInitializedAsync();
    }

    protected override async void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        await JSRuntime.InvokeVoidAsync("LoadScripts", "initCatalogs");
    }
}
