@code {
    [Parameter]
    public int catalogId { get; set; } = 0;
    public Catalog Catalog { get; set; } = new();

    string title = string.Empty;
    string html = string.Empty;

    protected override void OnParametersSet()
    {
        //title = await JSRuntime.InvokeAsync<string>("geVideoTitle", Catalog.Data);
        Catalog = CatalogService.GetCatalog(catalogId);
        base.OnParametersSet();
    }


    protected override async void OnAfterRender(bool firstRender)
    {
        title = await JSRuntime.InvokeAsync<string>("geVideoTitle", Catalog.Data);
        html = await JSRuntime.InvokeAsync<string>("geVideoHtml", Catalog.Data);

        //this.StateHasChanged()
        if (firstRender)
        {
            this.StateHasChanged();

            long userId = long.Parse(await JSRuntime.InvokeAsync<string>("getUserId"));
            //JSRuntime.InvokeVoidAsync("initCatalogPage", catalogId, userId);
            await JSRuntime.InvokeVoidAsync("LoadScripts", "initCatalogPage", catalogId, userId);
        }
        base.OnAfterRender(firstRender);
    }
}
