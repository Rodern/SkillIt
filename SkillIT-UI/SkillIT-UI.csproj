<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>$(MSBuildProjectName.Replace("-", "_"))</RootNamespace>
    <PackageIcon>20220808_104533_0002.png</PackageIcon>
    <RepositoryType>https://github.com/Rodern/SkillIt.git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Company>SkillIT Educate</Company>
    <Product>SkillIT WebApp</Product>
    <UserSecretsId>23fd3ebd-e845-484f-9fa8-cf3e1db85ff3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Tailwindcss\Index.css" />
    
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="C:\Users\Rodern\source\repos\SkillIt\SkillIT-UI\.editorconfig" />
    <None Include="wwwroot\assets\icons\20220808_104533_0002.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazor.CkEditor5" Version="1.0.2" />
    <PackageReference Include="Blazored.LocalStorage" Version="4.3.0" />
    <PackageReference Include="Blazored.TextEditor" Version="1.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="7.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="SendGrid" Version="9.29.3" />
    <PackageReference Include="SixLabors.ImageSharp.Web" Version="3.1.3" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BusinessLogic\BusinessLogic.csproj" />
    <ProjectReference Include="..\SkillIT-Models\SkillIT-Models.csproj" />
  </ItemGroup>

  <Target Name="CheckForNPM" BeforeTargets="BuildTailwindcss">
    <Exec Command="npm -v" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
    </Exec>
    <Error Condition="'$(ErrorCode)' != '0'" Text="You must install NPM to build this project" />
  </Target>

  <Target Name="BuildTailwindcss" BeforeTargets="Compile">
    <Exec EnvironmentVariables="NODE_ENV=production" Command="npx tailwindcss -i ./Tailwindcss/Index.css -o ./wwwroot/styles/styles.css --minify" Condition="'$(Configuration)' == 'Release'" />
  </Target>

  <ItemGroup>
    <Folder Include="Pages\AdminPanel\CourseManagement\" />
    <Folder Include="Pages\AdminPanel\CatalogManagement\" />
    <Folder Include="Pages\UserAccount\" />
    <Folder Include="Shared\CourseComponents\" />
    <Folder Include="Shared\CatalogComponents\" />
    <Folder Include="Shared\NotificationComponents\" />
    <Folder Include="wwwroot\site_data\course_data\" />
    <Folder Include="wwwroot\site_data\thumbnails\" />
  </ItemGroup>

  <ItemGroup>
    <EditorConfigFiles Remove="C:\Users\Rodern\source\repos\SkillIt\SkillIT-UI\.editorconfig" />
  </ItemGroup>

  <ItemGroup>
    
  </ItemGroup>

  <Target Name="LoadEnvSecrets" BeforeTargets="BeforeBuild" Condition="Exists('$(MSBuildProjectDirectory)\..\.env')">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\load-secrets.ps1&quot; -EnvPath &quot;$(MSBuildProjectDirectory)\..\.env&quot; -ProjectPath &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>

</Project>
