{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "CONFIGURE_IN_USER_SECRETS"
  },
  "JwtSettings": {
    "SecretKey": "CONFIGURE_IN_USER_SECRETS",
    "Issuer": "SkillIT-API",
    "Audience": "SkillIT-Client",
    "ExpirationMinutes": 60
  }
}
